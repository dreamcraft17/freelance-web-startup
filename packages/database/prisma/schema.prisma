// Production Prisma schema — freelance marketplace SaaS
// Soft delete: filter `deletedAt IS NULL` in repositories/services for active records.

generator client {
  provider      = "prisma-client-js"
  // Vercel / AWS Lambda (Node 20) use OpenSSL 3 — include alongside local dev "native"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserRole {
  ADMIN
  CLIENT
  FREELANCER
  AGENCY_OWNER
  AGENCY_MANAGER
  AGENCY_MEMBER
  SUPPORT_ADMIN
  FINANCE_ADMIN
  MODERATOR
}

enum AccountStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  BANNED
  DELETED
}

enum WorkMode {
  REMOTE
  ONSITE
  HYBRID
}

enum AvailabilityStatus {
  AVAILABLE
  LIMITED
  UNAVAILABLE
  ON_LEAVE
}

enum VerificationStatus {
  NOT_VERIFIED
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum JobStatus {
  DRAFT
  OPEN
  IN_REVIEW
  PAUSED
  CLOSED
  CANCELLED
  ARCHIVED
}

enum JobVisibility {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}

enum BudgetType {
  FIXED
  HOURLY
  RANGE
  REQUEST_QUOTE
}

enum BidStatus {
  DRAFT
  SUBMITTED
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
  CANCELLED
}

enum ContractStatus {
  PENDING
  PAYMENT_PENDING
  PAYMENT_FAILED
  ACTIVE
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  CANCELLED
  DISPUTED
  ARCHIVED
}

enum ContractPaymentStatus {
  NONE
  PENDING
  CONFIRMED
  FAILED
  EXPIRED
}

enum EscrowStatus {
  NONE
  LOCKED
  PARTIAL_RELEASED
  FULLY_RELEASED
  DISPUTED
  REFUNDED
}

enum PaymentTransactionType {
  CHARGE
  REFUND
  PAYOUT
}

enum PaymentTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum BoostTargetType {
  JOB
  PROFILE
}

enum BoostStatus {
  ACTIVE
  EXPIRED
  PAUSED
}

enum SuspensionLevel {
  WARNING
  SOFT_SUSPEND
  HARD_SUSPEND
}

enum SuspensionStatus {
  ACTIVE
  APPEALED
  RESOLVED
}

enum AppealStatus {
  PENDING
  APPROVED
  DENIED
  PENDING_MORE_INFO
}

enum DisputeStatus {
  OPEN
  REVIEWING
  RESOLVED
  APPEALED
}

enum DisputeDecision {
  FAVOR_CLIENT
  FAVOR_FREELANCER
  SPLIT
}

enum PayoutRequestStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum EscrowTransactionType {
  LOCK
  PARTIAL_RELEASE
  FULL_RELEASE
  REFUND
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum PaymentIntentKind {
  SUBSCRIPTION_PLAN
  JOB_FEATURED
  FREELANCER_BOOST
  CONTRACT_ESCROW
  BOOST_PURCHASE
}

enum PaymentIntentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

enum NotificationType {
  BID_SUBMITTED
  BID_SHORTLISTED
  BID_ACCEPTED
  CONTRACT_STARTED
  NEW_MESSAGE
  REVIEW_RECEIVED
  VERIFICATION_UPDATED
  BILLING_UPDATED
  ADMIN_MODERATION_EVENT
  ESCROW_PAYMENT_REQUIRED
  ESCROW_WORK_SUBMITTED
  ESCROW_RELEASED
  PAYOUT_SENT
  APPEAL_UPDATED
  RECOMMENDATION_DIGEST
}

enum MessageThreadType {
  DIRECT
  JOB
  CONTRACT
}

enum ReviewTargetType {
  CLIENT
  FREELANCER
}

enum ModerationReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum ModerationReportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ModerationReportSubjectType {
  USER
  JOB
  BID
  REVIEW
  MESSAGE_THREAD
  MESSAGE
}

enum VerificationType {
  IDENTITY
  BUSINESS
  ADDRESS
  CERTIFICATION
  PAYMENT_METHOD
}

// -----------------------------------------------------------------------------
// User & profiles (soft delete on User + profiles)
// -----------------------------------------------------------------------------

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String?
  role          UserRole
  accountStatus AccountStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  freelancerProfile FreelancerProfile?
  clientProfile     ClientProfile?

  subscriptions UserSubscription[]
  notifications Notification[]

  sentMessages Message[] @relation("MessageSender")

  verificationRequests VerificationRequest[] @relation("VerificationRequestSubject")
  verificationReviews  VerificationRequest[] @relation("VerificationRequestReviewer")

  reviewsGiven Review[] @relation("ReviewAuthor")

  reviewsReceivedAsClient     Review[] @relation("ReviewTargetClientUser")
  reviewsReceivedAsFreelancer Review[] @relation("ReviewTargetFreelancerUser")

  savedJobs        SavedJob[]
  savedFreelancers SavedFreelancer[]

  messageThreadParticipants MessageThreadParticipant[]

  contractsAsFreelancer Contract[] @relation("FreelancerContract")
  contractsAsClient     Contract[] @relation("ClientContract")

  auditLogsAsActor AuditLog[] @relation("AuditLogActor")

  donations        Donation[]
  paymentIntents   PaymentIntent[]

  bankAccounts     BankAccount[]
  boosts           Boost[]
  recommendations  Recommendation[]
  payoutRequests   PayoutRequest[]
  walletBalance    FreelancerWallet?

  userSuspension   UserSuspension?
  suspensionsApplied UserSuspension[] @relation("SuspensionAppliedBy")
  suspensionAppealsReviewed SuspensionAppeal[] @relation("AppealReviewer")
  contractDisputesAssigned ContractDispute[] @relation("DisputeModerator")

  moderationReportsFiled ModerationReport[] @relation("ModerationReportReporter")
  moderationReportsAssigned ModerationReport[] @relation("ModerationReportAssignee")
  moderationReportsStatusActor ModerationReport[] @relation("ModerationReportStatusActor")
  moderationReportNotesAuthored ModerationReportNote[] @relation("ModerationReportNoteAuthor")

  jobsModerationHidden Job[] @relation("JobModerationHiddenBy")

  @@index([role, accountStatus])
  @@index([email, deletedAt])
  @@index([deletedAt])
}

model FreelancerProfile {
  id     String @id @default(cuid())
  userId String @unique

  username String @unique
  fullName String
  headline String?
  bio      String? @db.Text

  avatarUrl          String?
  hourlyRate         Decimal? @db.Decimal(12, 2)
  fixedStartingPrice Decimal? @db.Decimal(12, 2)

  workMode           WorkMode           @default(REMOTE)
  availabilityStatus AvailabilityStatus @default(AVAILABLE)

  city    String?
  region  String?
  country String?
  lat     Decimal? @db.Decimal(10, 7)
  lng     Decimal? @db.Decimal(10, 7)
  serviceRadiusKm Int?

  yearsExperience    Int?
  verificationStatus VerificationStatus @default(NOT_VERIFIED)
  profileCompleteness Int               @default(0)
  isFeatured         Boolean            @default(false)

  /// Search boost (optional expiry). Ranking only; not a paywall.
  isBoosted    Boolean   @default(false)
  boostedUntil DateTime?

  /// Denormalized from reviews where this profile is the freelancer target.
  reviewCount          Int    @default(0)
  averageReviewRating  Float?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  bids           Bid[]
  portfolioItems PortfolioItem[]
  skills         FreelancerSkill[]

  reviewsReceived Review[] @relation("ReviewTargetFreelancerProfile")

  savedByUsers SavedFreelancer[] @relation("SavedFreelancerTarget")

  @@index([userId, deletedAt])
  @@index([username, deletedAt])
  @@index([city, country, deletedAt])
  @@index([workMode, availabilityStatus, deletedAt])
  @@index([lat, lng])
  @@index([deletedAt, workMode, createdAt])
  @@index([deletedAt, isBoosted, boostedUntil, createdAt])
  @@index([deletedAt, isFeatured, createdAt])
}

model ClientProfile {
  id     String @id @default(cuid())
  userId String @unique

  displayName String
  companyName String?
  industry    String?

  city    String?
  region  String?
  country String?

  verificationStatus VerificationStatus @default(NOT_VERIFIED)

  /// Denormalized from reviews where this profile is the client target.
  reviewCount         Int    @default(0)
  averageReviewRating Float?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobs Job[]

  reviewsReceived Review[] @relation("ReviewTargetClientProfile")

  @@index([userId, deletedAt])
  @@index([displayName])
}

// -----------------------------------------------------------------------------
// Taxonomy
// -----------------------------------------------------------------------------

model Category {
  id           String  @id @default(cuid())
  slug         String  @unique
  name         String
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subcategories Subcategory[]
  skills        Skill[]
  jobs          Job[]

  @@index([isActive, displayOrder])
}

model Subcategory {
  id         String @id @default(cuid())
  categoryId String
  slug       String @unique
  name       String

  metadataSchema Json?
  isActive       Boolean @default(true)
  displayOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  jobs     Job[]
  skills   Skill[]

  @@index([categoryId, isActive])
}

model Skill {
  id            String  @id @default(cuid())
  slug          String  @unique
  name          String
  categoryId    String?
  subcategoryId String?
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  freelancerSkills FreelancerSkill[]
  jobSkills        JobSkill[]

  @@index([categoryId, subcategoryId])
  @@index([isActive])
}

model FreelancerSkill {
  id                  String @id @default(cuid())
  freelancerProfileId String
  skillId             String
  years               Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  freelancerProfile FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  skill             Skill             @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([freelancerProfileId, skillId])
  @@index([skillId])
}

// -----------------------------------------------------------------------------
// Jobs
// -----------------------------------------------------------------------------

model Job {
  id              String @id @default(cuid())
  clientProfileId String
  categoryId      String
  subcategoryId   String?

  title       String
  slug        String @unique
  description String @db.Text
  language    String @default("en") @db.VarChar(2)
  titleEn     String?
  titleId     String?
  descriptionEn String? @db.Text
  descriptionId String? @db.Text

  budgetType BudgetType
  budgetMin  Decimal?   @db.Decimal(12, 2)
  budgetMax  Decimal?   @db.Decimal(12, 2)
  currency   String     @default("IDR") @db.VarChar(3)

  workMode WorkMode

  city    String?
  region  String?
  country String?
  lat     Decimal? @db.Decimal(10, 7)
  lng     Decimal? @db.Decimal(10, 7)

  onsiteAddress String? @db.Text

  bidDeadline DateTime?

  visibility JobVisibility @default(PUBLIC)
  status     JobStatus     @default(DRAFT)

  requiredVerification VerificationStatus?
  portfolioRequired    Boolean           @default(false)

  /// Promoted listing (optional expiry). Ranking only; not a paywall.
  isFeatured    Boolean   @default(false)
  featuredUntil DateTime?

  /// Public detail page views (incremented on GET /api/jobs/:id).
  viewCount Int @default(0)

  metadata Json?

  /// Hidden from public discovery by staff (owner may still see listing in app).
  moderationHiddenAt      DateTime?
  moderationHiddenReason  String? @db.Text
  moderationHiddenByUserId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  moderationHiddenBy User? @relation("JobModerationHiddenBy", fields: [moderationHiddenByUserId], references: [id], onDelete: SetNull)

  clientProfile ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Restrict)
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory   Subcategory?  @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  bids        Bid[]
  skills      JobSkill[]
  attachments JobAttachment[]

  messageThreads MessageThread[] @relation("ThreadJob")
  savedByUsers   SavedJob[]
  recommendations Recommendation[]

  @@index([clientProfileId, status, deletedAt])
  @@index([categoryId, subcategoryId])
  @@index([workMode, city, country, deletedAt])
  @@index([status, bidDeadline])
  @@index([visibility, status])
  @@index([createdAt])
  @@index([deletedAt, status, visibility, createdAt])
  @@index([clientProfileId, deletedAt, updatedAt])
  @@index([moderationHiddenAt])
}

model JobSkill {
  id      String @id @default(cuid())
  jobId   String
  skillId String

  createdAt DateTime @default(now())

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([jobId, skillId])
  @@index([skillId])
}

model JobAttachment {
  id       String @id @default(cuid())
  jobId    String
  fileUrl  String
  fileName String
  mimeType String
  sizeBytes Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, deletedAt])
}

// -----------------------------------------------------------------------------
// Bids & contracts
// -----------------------------------------------------------------------------

model Bid {
  id           String @id @default(cuid())
  jobId        String
  freelancerId String

  status BidStatus @default(SUBMITTED)

  bidAmount     Decimal @db.Decimal(12, 2)
  coverLetter   String  @db.Text
  estimatedDays Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job        Job               @relation(fields: [jobId], references: [id], onDelete: Restrict)
  freelancer FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Restrict)

  contract Contract?

  @@unique([jobId, freelancerId])
  @@index([freelancerId, status])
  @@index([jobId, status])
  @@index([createdAt])
}

model Contract {
  id String @id @default(cuid())

  bidId String @unique

  freelancerUserId String
  clientUserId     String

  amount   Decimal? @db.Decimal(12, 2)
  currency String?  @db.VarChar(3)

  startDate DateTime?
  endDate   DateTime?

  status ContractStatus @default(PENDING)

  paymentStatus      ContractPaymentStatus @default(NONE)
  escrowStatus       EscrowStatus          @default(NONE)
  escrowAmountCents  Int?
  escrowReleasedAt   DateTime?
  workSubmittedAt    DateTime?
  workReviewDeadline DateTime?
  paymentDueAt       DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  bid Bid @relation(fields: [bidId], references: [id], onDelete: Restrict)

  freelancerUser User @relation("FreelancerContract", fields: [freelancerUserId], references: [id], onDelete: Restrict)
  clientUser     User @relation("ClientContract", fields: [clientUserId], references: [id], onDelete: Restrict)

  reviews        Review[]
  messageThreads MessageThread[] @relation("ThreadContract")

  paymentIntent    PaymentIntent?
  paymentTransactions PaymentTransaction[]
  escrowTransactions  EscrowTransaction[]
  dispute             ContractDispute?

  @@index([freelancerUserId, status, deletedAt])
  @@index([clientUserId, status, deletedAt])
  @@index([status, createdAt])
  @@index([clientUserId, deletedAt, updatedAt])
  @@index([freelancerUserId, deletedAt, updatedAt])
}

// -----------------------------------------------------------------------------
// Subscriptions (plan entitlements as JSON on plan; snapshot on subscription)
// -----------------------------------------------------------------------------

model SubscriptionPlan {
  id String @id @default(cuid())

  code String @unique
  name String

  billingCycle BillingCycle
  priceCents   Int
  currency     String       @db.VarChar(3)

  /// Key-value style entitlements embedded for simplicity (e.g. maxActiveBids). Normalize later if needed.
  entitlements Json?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions UserSubscription[]

  @@index([isActive, code])
}

model UserSubscription {
  id     String @id @default(cuid())
  userId String
  planId String

  status SubscriptionStatus

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime

  cancelAtPeriodEnd Boolean @default(false)

  /// Immutable-ish snapshot of plan + entitlements at purchase/renewal for audit disputes.
  snapshot Json

  externalSubscriptionId String?
  externalCustomerId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([planId])
  @@index([externalSubscriptionId])
  @@index([currentPeriodEnd])
}

/// Pending / completed payment attempts (PSP-agnostic; provider MOCK until real checkout).
model PaymentIntent {
  id     String @id @default(cuid())
  userId String

  contractId String? @unique

  kind   PaymentIntentKind
  status PaymentIntentStatus @default(PENDING)

  provider String @default("MOCK") @db.VarChar(32)
  currency String @db.VarChar(3)
  amountCents Int

  stripeIntentId  String? @unique @db.VarChar(128)
  midtransOrderId String? @unique @db.VarChar(128)

  checkoutUrl String @db.Text

  idempotencyKey String? @unique @db.VarChar(128)

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contract Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([contractId])
}

/// Optional platform support payment (mock provider today; swap for Stripe/Midtrans/Xendit).
model Donation {
  id        String   @id @default(cuid())
  userId    String?
  amount    Decimal  @db.Decimal(14, 2)
  currency  String   @default("USD") @db.VarChar(3)
  message   String?
  provider  String   @default("MOCK") @db.VarChar(32)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// Reviews
// -----------------------------------------------------------------------------

model Review {
  id String @id @default(cuid())

  contractId   String
  authorUserId String

  targetType ReviewTargetType

  targetClientUserId        String?
  targetFreelancerUserId    String?
  targetClientProfileId     String?
  targetFreelancerProfileId String?

  rating  Int
  comment String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  author   User     @relation("ReviewAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  targetClientUser     User? @relation("ReviewTargetClientUser", fields: [targetClientUserId], references: [id], onDelete: SetNull)
  targetFreelancerUser User? @relation("ReviewTargetFreelancerUser", fields: [targetFreelancerUserId], references: [id], onDelete: SetNull)

  targetClientProfile     ClientProfile?     @relation("ReviewTargetClientProfile", fields: [targetClientProfileId], references: [id], onDelete: SetNull)
  targetFreelancerProfile FreelancerProfile? @relation("ReviewTargetFreelancerProfile", fields: [targetFreelancerProfileId], references: [id], onDelete: SetNull)

  @@unique([contractId, authorUserId, targetType])
  @@index([contractId])
  @@index([targetFreelancerProfileId])
  @@index([targetClientProfileId])
  @@index([rating, createdAt])
}

// -----------------------------------------------------------------------------
// Portfolio
// -----------------------------------------------------------------------------

model PortfolioItem {
  id                  String @id @default(cuid())
  freelancerProfileId String

  title       String
  description String? @db.Text
  mediaUrl    String
  mediaType   String? @db.VarChar(64)

  displayOrder Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  freelancerProfile FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)

  @@index([freelancerProfileId, deletedAt, displayOrder])
}

// -----------------------------------------------------------------------------
// Verification
// -----------------------------------------------------------------------------

model VerificationRequest {
  id     String @id @default(cuid())
  userId String

  type   VerificationType
  status VerificationStatus @default(PENDING)

  note     String? @db.Text
  evidence Json?

  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNote       String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("VerificationRequestSubject", fields: [userId], references: [id], onDelete: Cascade)

  reviewer User? @relation("VerificationRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([type, status, createdAt])
  @@index([reviewedByUserId])
}

// -----------------------------------------------------------------------------
// Saved items
// -----------------------------------------------------------------------------

model SavedJob {
  id     String @id @default(cuid())
  userId String
  jobId  String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, createdAt])
}

model SavedFreelancer {
  id                  String @id @default(cuid())
  userId              String
  freelancerProfileId String

  createdAt DateTime @default(now())

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  freelancerProfile FreelancerProfile @relation("SavedFreelancerTarget", fields: [freelancerProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, freelancerProfileId])
  @@index([userId, createdAt])
}

// -----------------------------------------------------------------------------
// Messaging (participants derived from job/contract context in app layer for DIRECT threads)
// -----------------------------------------------------------------------------

model MessageThread {
  id String @id @default(cuid())

  type MessageThreadType

  jobId      String?
  contractId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job      Job?      @relation("ThreadJob", fields: [jobId], references: [id], onDelete: SetNull)
  contract Contract? @relation("ThreadContract", fields: [contractId], references: [id], onDelete: SetNull)

  messages     Message[]
  participants MessageThreadParticipant[]

  @@index([type, updatedAt])
  @@index([jobId])
  @@index([contractId])
}

model MessageThreadParticipant {
  id       String @id @default(cuid())
  threadId String
  userId   String

  createdAt DateTime @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId, createdAt])
  @@index([userId, threadId])
}

model Message {
  id String @id @default(cuid())

  threadId String
  senderId String

  body     String  @db.Text
  isSystem Boolean @default(false)

  /// Optional client-provided attachment URLs (MVP; no upload storage).
  metadata Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([threadId, createdAt])
  @@index([senderId])
  @@index([deletedAt])
  @@index([threadId, deletedAt, createdAt])
}

// -----------------------------------------------------------------------------
// Notifications & audit
// -----------------------------------------------------------------------------

model Notification {
  id String @id @default(cuid())

  userId String
  type   NotificationType

  title String
  body  String @db.Text

  payload Json?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  /// Optional soft hide without deleting history
  dismissedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, dismissedAt])
  @@index([type, createdAt])
}

model AuditLog {
  id String @id @default(cuid())

  actorId String?

  action     String
  targetType String
  targetId   String

  metadata Json?

  createdAt DateTime @default(now())

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

// -----------------------------------------------------------------------------
// Moderation & trust / safety
// -----------------------------------------------------------------------------

model ModerationReport {
  id String @id @default(cuid())

  reporterUserId String
  subjectType    ModerationReportSubjectType
  /// Canonical subject id used for active-report deduplication across polymorphic columns.
  subjectKey     String                      @db.VarChar(191)

  subjectUserId    String?
  subjectJobId     String?
  subjectBidId     String?
  subjectReviewId  String?
  subjectThreadId  String?
  subjectMessageId String?

  category    String @db.VarChar(96)
  description String @db.Text

  status   ModerationReportStatus   @default(OPEN)
  priority ModerationReportPriority @default(NORMAL)

  slaDueAt        DateTime
  escalatedAt     DateTime?
  escalationLevel Int       @default(0)

  assignedToStaffUserId String?

  resolvedAt  DateTime?
  dismissedAt DateTime?

  resolutionSummary     String? @db.Text
  statusUpdatedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reporter User @relation("ModerationReportReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)

  assignedToStaff User? @relation("ModerationReportAssignee", fields: [assignedToStaffUserId], references: [id], onDelete: SetNull)

  statusUpdatedBy User? @relation("ModerationReportStatusActor", fields: [statusUpdatedByUserId], references: [id], onDelete: SetNull)

  notes ModerationReportNote[]

  @@index([status, createdAt])
  @@index([status, slaDueAt])
  @@index([priority, status, createdAt])
  @@index([subjectType])
  @@index([assignedToStaffUserId])
  @@index([reporterUserId, createdAt])
}

model ModerationReportNote {
  id String @id @default(cuid())

  reportId         String
  authorStaffUserId String
  body             String @db.Text

  createdAt DateTime @default(now())

  report       ModerationReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  authorStaff User            @relation("ModerationReportNoteAuthor", fields: [authorStaffUserId], references: [id], onDelete: Restrict)

  @@index([reportId, createdAt])
}

// -----------------------------------------------------------------------------
// NearWork V2 — payments, escrow, boosts, recommendations, appeals
// -----------------------------------------------------------------------------

model PaymentTransaction {
  id         String @id @default(cuid())
  contractId String?

  type     PaymentTransactionType
  amount   Int
  currency String @db.VarChar(3)
  fee      Int    @default(0)
  status   PaymentTransactionStatus @default(PENDING)

  provider      String @db.VarChar(32)
  providerTxnId String @db.VarChar(191)

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@index([contractId])
  @@index([provider, providerTxnId])
  @@index([status, createdAt])
}

model EscrowTransaction {
  id         String @id @default(cuid())
  contractId String

  type      EscrowTransactionType
  amount    Int
  reason    String? @db.Text
  createdBy String? @db.VarChar(72)

  createdAt DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([createdAt])
}

model ContractDispute {
  id         String @id @default(cuid())
  contractId String @unique

  initiatedByUserId String
  reason            String @db.Text
  evidence          String[]

  assignedToStaffUserId String?
  assignedModerator     User? @relation("DisputeModerator", fields: [assignedToStaffUserId], references: [id], onDelete: SetNull)

  status     DisputeStatus  @default(OPEN)
  decision   DisputeDecision?
  resolution String? @db.Text

  resolutionAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([assignedToStaffUserId])
}

model BoostProduct {
  id           String @id @default(cuid())
  code         String @unique
  name         String
  type         String @db.VarChar(64)
  durationDays Int
  priceCents   Int
  currency     String @default("IDR") @db.VarChar(3)
  config       Json?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  boosts Boost[]

  @@index([isActive, type])
}

model Boost {
  id        String @id @default(cuid())
  userId    String
  productId String

  targetType BoostTargetType
  targetId   String

  status    BoostStatus @default(ACTIVE)
  expiresAt DateTime
  expiredAt DateTime?

  paymentTxnId String? @db.VarChar(72)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  product BoostProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@index([targetType, targetId, status])
}

model Recommendation {
  id           String @id @default(cuid())
  freelancerId String
  jobId        String

  score        Int
  matchReasons String[]

  viewedAt  DateTime?
  clickedAt DateTime?
  bidSentAt DateTime?

  createdAt DateTime @default(now())
  expiresAt DateTime

  freelancer User @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  job        Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([freelancerId, jobId])
  @@index([freelancerId, score])
  @@index([expiresAt])
}

model RecommendationMetric {
  id             String   @id @default(cuid())
  date           DateTime @unique @db.Date
  totalGenerated Int      @default(0)
  totalViewed    Int      @default(0)
  totalClicked   Int      @default(0)
  totalBids      Int      @default(0)
  ctrRate        Float?

  createdAt DateTime @default(now())
}

model UserSuspension {
  id     String @id @default(cuid())
  userId String @unique

  level    SuspensionLevel
  reason   String @db.Text
  reportId String? @db.VarChar(72)

  status    SuspensionStatus @default(ACTIVE)
  expiresAt DateTime?

  appliedByUserId String
  appliedBy       User @relation("SuspensionAppliedBy", fields: [appliedByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  appeal SuspensionAppeal?

  @@index([status, level])
}

model SuspensionAppeal {
  id           String @id @default(cuid())
  suspensionId String @unique

  appealReason String @db.Text
  evidence     String[]

  status AppealStatus @default(PENDING)

  reviewedByUserId String?
  reviewer         User? @relation("AppealReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  decision     String? @db.Text
  decisionNote String? @db.Text

  createdAt DateTime  @default(now())
  decidedAt DateTime?

  suspension UserSuspension @relation(fields: [suspensionId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model BankAccount {
  id     String @id @default(cuid())
  userId String

  bankCode      String @db.VarChar(32)
  bankName      String @db.VarChar(120)
  accountNumber String @db.VarChar(64)
  accountName   String @db.VarChar(120)
  isDefault     Boolean @default(false)
  isVerified    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
}

model FreelancerWallet {
  id     String @id @default(cuid())
  userId String @unique

  balanceCents Int @default(0)
  currency     String @default("IDR") @db.VarChar(3)

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PayoutRequest {
  id     String @id @default(cuid())
  userId String

  amountCents Int
  currency    String @default("IDR") @db.VarChar(3)
  feeCents    Int    @default(0)

  bankAccountId String?

  status      PayoutRequestStatus @default(PENDING)
  receiptId   String? @db.VarChar(128)
  retryCount  Int     @default(0)
  nextRetryAt DateTime?
  lastError   String? @db.Text

  requestedAt DateTime @default(now())
  sentAt      DateTime?
  processedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, requestedAt])
}

model WebhookEvent {
  id          String @id @default(cuid())
  provider    String @db.VarChar(32)
  externalId  String @db.VarChar(191)
  eventType   String @db.VarChar(128)
  processedAt DateTime @default(now())

  @@unique([provider, externalId])
  @@index([provider, eventType])
}

model UserExperiment {
  id             String @id @default(cuid())
  userId         String
  experimentKey  String @db.VarChar(64)
  variant        String @db.VarChar(32)

  createdAt DateTime @default(now())

  @@unique([userId, experimentKey])
  @@index([experimentKey, variant])
}
